# Copy to backend/.env and adjust. Every value is optional in development.
DJANGO_SECRET_KEY=change-me
# Debug is off unless this says true. Keep it true only on your own machine.
DJANGO_DEBUG=true
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# On an HTTPS-only server: secure cookies, HTTPS redirect and HSTS.
# Needs a real DJANGO_SECRET_KEY (python -c "import secrets; print(secrets.token_urlsafe(50))").
# DJANGO_SECURE_HTTPS=true

# Where the React app runs (used in password reset emails)
FRONTEND_URL=http://localhost:8085

# PostgreSQL instead of SQLite, e.g. Supabase or Neon
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Only needed if the frontend is served from a different origin than the API
# CORS_ALLOWED_ORIGINS=http://localhost:8085
# CSRF_TRUSTED_ORIGINS=http://localhost:8085

# SMTP (without it, emails are printed in the runserver terminal)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=you@example.com
# EMAIL_HOST_PASSWORD=app-password
# DEFAULT_FROM_EMAIL=INTERIO <you@example.com>

# Who gets emails about new bookings and contact messages (default: every staff user)
# STAFF_NOTIFICATION_EMAILS=studio@example.com,owner@example.com
