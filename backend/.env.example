# Copy to backend/.env and adjust. Every value is optional in development.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Where the React app runs (used in password reset emails)
FRONTEND_URL=http://localhost:8085

# PostgreSQL instead of SQLite, e.g. Supabase or Neon
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Only needed if the frontend is served from a different origin than the API
# CORS_ALLOWED_ORIGINS=http://localhost:8085
# CSRF_TRUSTED_ORIGINS=http://localhost:8085

# SMTP (without it, emails are printed in the runserver terminal)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=you@example.com
# EMAIL_HOST_PASSWORD=app-password
# DEFAULT_FROM_EMAIL=INTERIO <you@example.com>
